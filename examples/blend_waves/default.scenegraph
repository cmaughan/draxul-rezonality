surface: Waves { scale: (1, 1, 1) format: default_color }
pass: Generate {
    targets: (Waves)
    clear: (0.01, 0.01, 0.03, 1.0)
    geometry: background { path: screen_rect vs: screen.vert fs: waves.frag }
}
pass: Blend {
    samplers: (Waves)
    targets: (default_color)
    geometry: copy { path: screen_rect vs: screen.vert fs: blend.frag }
}
