# Optional low-resolution CRT presentation. Launch this project with
# scenegraph = "crt.scenegraph" to enable it.
camera: default_camera {
    position: (0.0, 1.55, 6.0)
    look_at: (0.0, 1.55, 0.0)
    field_of_view: 45.0
    near_far: (0.01, 50.0)
}

environment: studio_sky {
    path: ../../robot2/textures/environment/farm_field_puresky_1k.hdr
    format: rgba32f
}

surface: Depth {
    scale: (0.24, 0.24, 1.0)
    format: default_depth
}

surface: Signal {
    scale: (0.24, 0.24, 1.0)
    format: default_color
}

model: robot {
    path: ../../robot2/models/robot/scene.gltf
    scale: (1.0, 1.0, 1.0)
    uv_origin: lower_left
}

pass: Sky {
    targets: (Signal, Depth)
    clear: (0.0, 0.0, 0.0, 1.0)
    samplers: (studio_sky)
    camera: default_camera
    geometry: background {
        path: screen_rect
        vs: skybox.vert
        fs: skybox.frag
    }
}

pass: Robot {
    targets: (Signal, Depth)
    samplers: (studio_sky)
    camera: default_camera
    geometry: robot_mesh {
        model: robot
        vs: pbr.vert
        fs: pbr.frag
    }
}

pass: CRT {
    samplers: (Signal)
    targets: (default_color)
    geometry: display {
        path: screen_rect
        vs: copy.vert
        fs: crt.frag
    }
}
