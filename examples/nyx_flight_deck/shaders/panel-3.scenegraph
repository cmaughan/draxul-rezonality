# Full-resolution default. Select panel-3-crt.scenegraph to restore
# the low-resolution signal and CRT presentation pass.
pass: Instrument3 {
    targets: (default_color)
    clear: (0.001, 0.004, 0.012, 1.0)
    geometry: signal {
        path: screen_rect
        vs: fullscreen.vert
        fs: panel-3.frag
    }
}
