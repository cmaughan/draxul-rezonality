// NIGHT - a lighthouse sweeps its beams over a moonlit, glowing surf.
camera: default_camera {
    position: (-19.0, 4.8, 33.0)
    look_at: (2.0, 11.5, 0.0)
    field_of_view: 50.0
    near_far: (0.1, 3000.0)
}

surface: Scene {
    scale: (1.0, 1.0, 1.0)
    format: rgba16f
}

surface: Linear {
    scale: (1.0, 1.0, 1.0)
    format: rgba16f
}

surface: Depth {
    scale: (1.0, 1.0, 1.0)
    format: default_depth
}

surface: Lit {
    scale: (1.0, 1.0, 1.0)
    format: rgba16f
}

surface: BloomA {
    scale: (0.25, 0.25, 1.0)
    format: rgba16f
}

surface: BloomB {
    scale: (0.125, 0.125, 1.0)
    format: rgba16f
}

model: tower {
    path: lighthouse.obj
    scale: (1.0, 1.0, 1.0)
}

model: rocks {
    path: headland.obj
    scale: (1.0, 1.0, 1.0)
}

model: sea {
    path: ocean_grid.obj
    scale: (1.0, 1.0, 1.0)
}

pass: Sky {
    targets: (Scene, Linear, Depth)
    clear: (0.0, 0.0, 0.0, 1.0)
    camera: default_camera
    geometry: backdrop {
        path: screen_rect
        vs: ray.vert
        fs: night_backdrop.frag
    }
}

pass: Lighthouse {
    targets: (Scene, Linear, Depth)
    camera: default_camera
    geometry: lighthouse {
        model: tower
        vs: static_model.vert
        fs: lighthouse.frag
    }
}

pass: Headland {
    targets: (Scene, Linear, Depth)
    camera: default_camera
    geometry: headland {
        model: rocks
        vs: static_model.vert
        fs: headland.frag
    }
}

pass: Ocean {
    targets: (Scene, Linear, Depth)
    camera: default_camera
    geometry: swell {
        model: sea
        vs: night_ocean.vert
        fs: night_ocean.frag
    }
}

pass: Beams {
    samplers: (Scene, Linear)
    targets: (Lit)
    camera: default_camera
    geometry: beams {
        path: screen_rect
        vs: ray.vert
        fs: night_beam.frag
    }
}

pass: BloomExtract {
    samplers: (Lit)
    targets: (BloomA)
    geometry: extract {
        path: screen_rect
        vs: fullscreen.vert
        fs: bloom_extract.frag
    }
}

pass: BloomBlur {
    samplers: (BloomA)
    targets: (BloomB)
    geometry: blur {
        path: screen_rect
        vs: fullscreen.vert
        fs: bloom_blur.frag
    }
}

pass: Composite {
    samplers: (Lit, BloomA, BloomB)
    targets: (default_color)
    geometry: display {
        path: screen_rect
        vs: fullscreen.vert
        fs: post_night.frag
    }
}
