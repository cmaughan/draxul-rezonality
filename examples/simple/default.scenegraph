surface: A {
    format: default_color
    scale: (1, 1, 1)
    clear: (0.0, 0.0, 0.0, 1.0)
}

pass: Pass1 {
    targets: (A)
    clear: (0.0, 0.0, 0.0, 1.0)
    geometry: background {       // The geometry to submit
        path: screen_rect        // screen_rect is Quad
        vs: screen.vert
        fs: screen.frag
    }
}

pass: Composite {
    samplers: (A)
    targets: (default_color)
    geometry: copy {
        path: screen_rect
        vs: copy.vert
        fs: copy.frag
    }
}
