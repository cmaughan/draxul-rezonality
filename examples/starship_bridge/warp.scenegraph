# ENGINEERING - volumetric warp core with constrictor rings and arcs.
camera: default_camera {
    position: (2.6, 0.9, 4.4)
    look_at: (0.0, -0.1, 0.0)
    field_of_view: 55.0
    near_far: (0.05, 200.0)
}

surface: Scene {
    scale: (1.0, 1.0, 1.0)
    format: rgba16f
}

surface: BloomA {
    scale: (0.25, 0.25, 1.0)
    format: rgba16f
}

surface: BloomB {
    scale: (0.125, 0.125, 1.0)
    format: rgba16f
}

pass: WarpCore {
    targets: (Scene)
    clear: (0.0, 0.0, 0.0, 1.0)
    camera: default_camera
    geometry: core {
        path: screen_rect
        vs: ray.vert
        fs: warp.frag
    }
}

pass: BloomExtract {
    samplers: (Scene)
    targets: (BloomA)
    geometry: extract {
        path: screen_rect
        vs: fullscreen.vert
        fs: bloom_extract.frag
    }
}

pass: BloomBlur {
    samplers: (BloomA)
    targets: (BloomB)
    geometry: blur {
        path: screen_rect
        vs: fullscreen.vert
        fs: bloom_blur.frag
    }
}

pass: Composite {
    samplers: (Scene, BloomA, BloomB)
    targets: (default_color)
    geometry: display {
        path: screen_rect
        vs: fullscreen.vert
        fs: post_warp.frag
    }
}
